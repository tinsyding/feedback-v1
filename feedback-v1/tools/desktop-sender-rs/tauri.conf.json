{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "极方每周反馈程序",
  "version": "2.1.0",
  "identifier": "cn.wxjifang.feedback.sender",
  "build": {
    "frontendDist": "./ui"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "极方每周反馈程序 (Fluent 现代版)",
        "width": 1080,
        "height": 720,
        "minWidth": 860,
        "minHeight": 580,
        "resizable": true,
        "fullscreen": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/icon.ico"
    ]
  }
}
