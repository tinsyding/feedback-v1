# feedback-api (Go) environment configuration example
# Copy to an env file and set FEEDBACK_ENV_FILE=/path/to/.env (or load via systemd EnvironmentFile).
# Existing OS environment variables are never overwritten by FEEDBACK_ENV_FILE.

# HTTP listen address (default: 127.0.0.1:8090)
FEEDBACK_LISTEN_ADDR=127.0.0.1:8090

# Path to the feedback-v1 web root containing config.json, api/secret_key.local.php, and data/
FEEDBACK_ROOT=/www/wwwroot/JF/feedback-git/feedback-v1

# Optional path to a .env file loaded at process startup
# FEEDBACK_ENV_FILE=/etc/feedback-api/env

# Optional JSON secrets file (checked after OS env vars, before api/secret_key.local.php)
# Supports keys: senderApiToken, dashscopeApiKey, identifyApiBase, identifyModel, identifyFastModel, retestSecret
# FEEDBACK_SECRETS_FILE=/etc/feedback-api/secrets.json

# Custom sender API bearer/form token (when empty, only built-in DefaultSenderToken is accepted)
# SENDER_API_TOKEN=

# OpenAI-compatible vision API key (fallback when config.json["dashscopeApiKey"] is empty)
# DASHSCOPE_API_KEY=

# OpenAI-compatible vision endpoint (fallback when config.json["identifyApiBase"] is empty)
# Auto-appends /chat/completions if not already ending with /chat/completions
# IDENTIFY_API_BASE=https://dashscope.aliyuncs.com/compatible-mode/v1/chat/completions

# Default vision model for full/reply/calibrate (fallback when config.json is empty)
# IDENTIFY_MODEL=qwen3.8-max

# Fast vision model for title mode (fallback when config.json["identifyFastModel"] is empty)
# IDENTIFY_FAST_MODEL=qwen3.8-flash

# MySQL connection overrides for shared PHP/Go app_sessions (fallback to api/db.local.php)
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=feedback
# DB_USERNAME=root
# DB_PASSWORD=
# DB_CHARSET=utf8mb4

# QBank cryptographic attestation (Ed25519) settings
# Precedence: QBANK_ATTESTATION_PRIVATE_KEY -> QBANK_ATTESTATION_KEY_FILE -> deterministic KDF from retestSecret
# Accepts PKCS#8 PEM, 64-hex seed, 128-hex private key, Base64URL, or Base64
# QBANK_ATTESTATION_PRIVATE_KEY=
# QBANK_ATTESTATION_KEY_FILE=/etc/feedback-api/qbank-ed25519.pem
# Optional custom key ID (default: "jf-qb-" + first 8 hex chars of SHA-256(public_key))
# QBANK_ATTESTATION_KEY_ID=
# Optional public attestation issuer URL embedded in receipts & verify_url (default: https://feedback.wxjifang.cn)
# ATTESTATION_ISSUER=https://feedback.wxjifang.cn
# Optional RFC 3161 Time-Stamp Authority URL for Merkle batch anchoring (default: https://freetsa.org/tsr, set "off" for local_only)
# ATTESTATION_TSA_URL=https://freetsa.org/tsr
# Optional periodic Merkle anchoring interval (default: 24h, set "off" to disable background anchoring)
# ATTESTATION_ANCHOR_INTERVAL=24h
